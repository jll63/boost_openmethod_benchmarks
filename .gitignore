# Built binaries and CMake trees.
/bin/
/build/
/build-*/

# `include` is a symlink into a local Boost checkout, so it is machine-specific.
# Recreate it with:
#   ln -s /path/to/boost/libs/openmethod/include include
/include

# Scratch result sets; results/ itself is committed, since the README tables are
# generated from it and report.py must be able to reproduce them.
/results-*/
# ...except the archived Zen-box dataset, which report.py reads for the
# cross-machine comparison columns and must therefore be committed too.
!/results-zen/

# Editor and tool state.
/.vscode/
/.cache/
/.claude/

# asmtab.py imports report.py for the table formatting.
__pycache__/
